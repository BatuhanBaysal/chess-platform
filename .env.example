# ==============================================================================
# CHESS PLATFORM - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
CHESS_DB_URL=jdbc:postgresql://localhost:5432/your_database_name
CHESS_DB_USERNAME=your_db_username
CHESS_DB_PASSWORD=your_secure_db_password

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT CONFIGURATION
# ------------------------------------------------------------------------------
# 256-bit / 512-bit hex secret key for signing internal tokens
CHESS_JWT_SECRET=your_jwt_secret_here_min_64_hex_chars
# Expiration in milliseconds (e.g., 7 days = 604800000 ms)
CHESS_JWT_EXPIRATION=604800000

# ------------------------------------------------------------------------------
# 3. DEFAULT ADMIN SEED CONFIGURATION
# ------------------------------------------------------------------------------
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# ------------------------------------------------------------------------------
# 4. IDENTITY & ACCESS MANAGEMENT (Keycloak IAM)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password
KEYCLOAK_PORT=8081
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/chess-realm
KEYCLOAK_GUEST_CLIENT_SECRET=your_guest_client_secret_here
KEYCLOAK_EXTERNAL_URL=https://your-domain.example.com

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (AWS S3 / OCI / MinIO)
# ------------------------------------------------------------------------------
# For local MinIO: http://localhost:9000 | For OCI/AWS: https://<endpoint>
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=your_s3_access_key_here
AWS_S3_SECRET_KEY=your_s3_secret_key_here
AWS_S3_BUCKET_NAME=chess-storage
AWS_S3_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & MONITORING (Grafana / LGTM Stack)
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# Development API URL
VITE_API_URL=http://localhost:8080
VITE_SHOW_MONITORING=true

# Production API URL (Uncomment for production deployments)
# VITE_API_URL=https://your-domain.example.com

# ------------------------------------------------------------------------------
# 8. CODE QUALITY & ANALYSIS (SonarQube)
# ------------------------------------------------------------------------------
SONAR_ADMIN_USERNAME=admin
SONAR_ADMIN_PASSWORD=your_sonarqube_admin_password
SONAR_TOKEN=your_sonarqube_global_analysis_token

# ==========================================
# QUICK-REFERENCE SCAN COMMANDS (REFERENCE)
# ==========================================
# Backend Scan Command:
# cd chess-backend
# .\mvnw clean verify sonar:sonar "-Dsonar.projectKey=chess-platform" "-Dsonar.host.url=http://localhost:9002" "-Dsonar.token=your_sonarqube_global_analysis_token"
#
# Frontend Scan Command:
# cd chess-frontend
# npx sonarqube-scanner "-Dsonar.projectKey=chess-frontend" "-Dsonar.host.url=http://localhost:9002" "-Dsonar.token=your_sonarqube_global_analysis_token"
