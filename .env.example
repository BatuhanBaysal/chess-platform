# --- Chess Platform Environment Variables Example ---

# Database Configuration
CHESS_DB_URL=jdbc:postgresql://localhost:5432/your_db_here
CHESS_DB_USERNAME=your_username_here
CHESS_DB_PASSWORD=your_password_here

# JWT Authentication (7 days in milliseconds: 604800000)
CHESS_JWT_SECRET=your_jwt_secret_here
CHESS_JWT_EXPIRATION=604800000

# --- Grafana Admin Password ---
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# --- Default Admin Configuration (AdminSeeder) ---
ADMIN_USERNAME=your_admin_username_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# --- Frontend Environment Variables (Development) ---
VITE_API_URL=http://localhost:8080
VITE_SHOW_MONITORING=true

# --- Frontend Environment Variables (Production) ---
# VITE_API_URL=https://your-domain.duckdns.org
